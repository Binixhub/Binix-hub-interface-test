    sf.CanvasSize = UDim2.new(0,0,0,0); sf.AutomaticCanvasSize = Enum.AutomaticSize.Y; sf.Visible = false
    local cl = Instance.new("UIListLayout", sf); cl.Padding = UDim.new(0,5)
    local cp = Instance.new("UIPadding", sf)
    cp.PaddingTop = UDim.new(0,5); cp.PaddingLeft = UDim.new(0,2); cp.PaddingRight = UDim.new(0,4)
    tabContents[name] = sf; return sf
end

local activeTab = ""
local allTabs = {}
local _tti = TweenInfo.new(0.15, Enum.EasingStyle.Quad)

local function makeSideTab(name, order)
    local btn = Instance.new("TextButton", SideBar)
    btn.Size = UDim2.new(1,0,0,34); btn.LayoutOrder = order
    btn.BackgroundColor3 = Color3.fromRGB(10,10,10); btn.BackgroundTransparency = 0.3
    btn.TextColor3 = Color3.fromRGB(110,110,110); btn.Text = name
    btn.Font = Enum.Font.GothamBold; btn.TextSize = 12; btn.BorderSizePixel = 0
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0,7)
    local ind = Instance.new("Frame", btn)
    ind.Size = UDim2.new(0,0,0.6,0); ind.Position = UDim2.new(0,0,0.2,0)
    ind.BackgroundColor3 = Color3.fromRGB(200,200,200); ind.BorderSizePixel = 0
    Instance.new("UICorner", ind).CornerRadius = UDim.new(1,0)
    table.insert(allTabs, {btn=btn, ind=ind, name=name}); return btn
end

local function setTab(t)
    activeTab = t
    for _,d in ipairs(allTabs) do
        if d.name == t then
            TweenService:Create(d.btn,_tti,{BackgroundColor3=Color3.fromRGB(22,22,22),TextColor3=Color3.fromRGB(255,255,255)}):Play()
            TweenService:Create(d.ind,TweenInfo.new(0.2,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{Size=UDim2.new(0,4,0.6,0)}):Play()
        else
            TweenService:Create(d.btn,_tti,{BackgroundColor3=Color3.fromRGB(10,10,10),TextColor3=Color3.fromRGB(110,110,110)}):Play()
            TweenService:Create(d.ind,_tti,{Size=UDim2.new(0,0,0.6,0)}):Play()
        end
    end
    for name,sf in pairs(tabContents) do
        if name == t then
            sf.Visible = true
            sf.Position = UDim2.new(0,100,0,40)
            TweenService:Create(sf,TweenInfo.new(0.18,Enum.EasingStyle.Quad),{Position=UDim2.new(0,94,0,40)}):Play()
        else
            sf.Visible = false
        end
    end
end

