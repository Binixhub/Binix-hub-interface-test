local tabContents = {}
local function makeTabContent(name)
    local sf = Instance.new("ScrollingFrame", MainFrame)
    sf.Name = "C_"..name; sf.Size = UDim2.new(1,-98,1,-44); sf.Position = UDim2.new(0,94,0,40)
