    local state = false
    local btn = Instance.new("TextButton", row)
    btn.Size = UDim2.new(1,0,1,0); btn.BackgroundTransparency = 1; btn.Text = ""; btn.ZIndex = 5
    btn.MouseButton1Click:Connect(function()
        state = not state
        if state then
            TweenService:Create(knob,_ti,{Position=UDim2.new(0,22,0.5,-7),BackgroundColor3=Color3.fromRGB(255,255,255)}):Play()
            TweenService:Create(pill,_ti,{BackgroundColor3=Color3.fromRGB(38,38,38)}):Play()
            TweenService:Create(rs,_ti,{Color=Color3.fromRGB(85,85,85)}):Play()
            TweenService:Create(lbl,_ti,{TextColor3=Color3.fromRGB(255,255,255)}):Play()
        else
            TweenService:Create(knob,_ti,{Position=UDim2.new(0,3,0.5,-7),BackgroundColor3=Color3.fromRGB(85,85,85)}):Play()
            TweenService:Create(pill,_ti,{BackgroundColor3=Color3.fromRGB(26,26,26)}):Play()
            TweenService:Create(rs,_ti,{Color=Color3.fromRGB(32,32,32)}):Play()
            TweenService:Create(lbl,_ti,{TextColor3=Color3.fromRGB(205,205,205)}):Play()
        end
